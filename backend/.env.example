# ==============================================================================
# VERICAMP - Smart Faculty Attendance System (.env.example)
# Configuration for Flask backend, SQLAlchemy, and MySQL database connection
# ==============================================================================

# Server Configuration
PORT=5000
FLASK_ENV=production
SECRET_KEY=replace_with_a_secure_random_key_for_production

# ==============================================================================
# MySQL Database Configuration (PyMySQL Driver)
# Manageable via MySQL Workbench or MySQL Command Line Client
# ==============================================================================
# Option 1: Full Database Connection URL
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://vericamp_user:YourStrongPassword123!@localhost:3306/vericamp_db?charset=utf8mb4

# Option 2: Individual Connection Parameters (Alternative to DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=vericamp_user
MYSQL_PASSWORD=YourStrongPassword123!
MYSQL_DATABASE=vericamp_db

# Local SQLite Fallback (used automatically if MySQL is unreachable or not configured)
# SQLITE_FALLBACK=backend/vericamp.db

# ==============================================================================
# Campus Geofence Reference (Swami Keshvanand Institute of Technology - SKIT Jaipur)
# ==============================================================================
DEFAULT_CAMPUS_NAME=Swami Keshvanand Institute of Technology (SKIT) - Campus
DEFAULT_CAMPUS_LAT=26.8227
DEFAULT_CAMPUS_LON=75.8653
DEFAULT_CAMPUS_RADIUS_METERS=300.0
WIFI_SSID_REQUIRED=1
WIFI_SSID_NAME=SKIT_CAMPUS_SECURE

# ==============================================================================
# Biometric Facial Recognition Settings (YuNet ONNX Detector + SFace ONNX Recognizer)
# ==============================================================================
DATASET_DIR=backend/dataset/faces
YUNET_MODEL_PATH=backend/models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=backend/models/face_recognition_sface_2021dec.onnx
FACE_SIMILARITY_THRESHOLD=85.0
