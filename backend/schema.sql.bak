-- ====================================================================
-- VERICAMP - Smart Faculty Attendance System
-- Database Schema for MySQL 8.x / MariaDB
-- Manageable via MySQL Workbench or MySQL Command-Line Client
-- ====================================================================

CREATE DATABASE IF NOT EXISTS `vericamp_db` 
CHARACTER SET utf8mb4 
COLLATE utf8mb4_unicode_ci;

USE `vericamp_db`;

-- --------------------------------------------------------------------
-- 1. Table: users (Faculty & Administrative Accounts)
-- --------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `users` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `employee_id` VARCHAR(50) NOT NULL UNIQUE,
    `full_name` VARCHAR(120) NOT NULL,
    `email` VARCHAR(120) NOT NULL,
    `department` VARCHAR(100) NOT NULL,
    `password_hash` VARCHAR(255) NOT NULL,
    `role` ENUM('teacher', 'admin') NOT NULL DEFAULT 'teacher',
    `phone` VARCHAR(30) NULL,
    `is_active` TINYINT(1) NOT NULL DEFAULT 1,
    `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX `idx_users_employee_id` (`employee_id`),
    INDEX `idx_users_role` (`role`),
    INDEX `idx_users_department` (`department`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------------------
-- 2. Table: face_enrollments (Biometric Reference Templates)
-- --------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `face_enrollments` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NOT NULL UNIQUE,
    `face_template` TEXT NOT NULL COMMENT 'Access-controlled template hash/embedding vector',
    `model_name` VARCHAR(60) NOT NULL DEFAULT 'OpenCV-Haar-HSV-Histogram',
    `model_version` VARCHAR(20) NOT NULL DEFAULT 'v2.4',
    `enrollment_status` ENUM('enrolled', 'pending', 'revoked') NOT NULL DEFAULT 'enrolled',
    `enrolled_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT `fk_face_user` FOREIGN KEY (`user_id`) 
        REFERENCES `users` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------------------
-- 3. Table: attendance_records (Immutable Verified Presence Logs)
-- --------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `attendance_records` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NOT NULL,
    `attendance_date` DATE NOT NULL,
    `check_in_time` TIME NOT NULL,
    `latitude` DECIMAL(10, 7) NOT NULL,
    `longitude` DECIMAL(10, 7) NOT NULL,
    `distance_meters` DECIMAL(8, 2) NOT NULL,
    `face_score` DECIMAL(5, 2) NOT NULL,
    `face_verification_status` ENUM('verified', 'failed') NOT NULL,
    `location_verification_status` ENUM('verified', 'failed') NOT NULL,
    `attendance_status` ENUM('present', 'late', 'rejected') NOT NULL,
    `device_info` VARCHAR(255) NULL,
    `failure_reason` VARCHAR(255) NULL,
    `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX `idx_attendance_user` (`user_id`),
    INDEX `idx_attendance_date` (`attendance_date`),
    INDEX `idx_attendance_status` (`attendance_status`),
    INDEX `idx_attendance_user_date` (`user_id`, `attendance_date`),
    CONSTRAINT `fk_attendance_user` FOREIGN KEY (`user_id`) 
        REFERENCES `users` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------------------
-- 4. Table: campus_settings (Institutional Geofence Coordinates)
-- --------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `campus_settings` (
    `id` INT PRIMARY KEY,
    `campus_name` VARCHAR(150) NOT NULL,
    `latitude` DECIMAL(10, 7) NOT NULL,
    `longitude` DECIMAL(10, 7) NOT NULL,
    `allowed_radius_meters` DECIMAL(8, 2) NOT NULL DEFAULT 300.00,
    `wifi_ssid_required` TINYINT(1) NOT NULL DEFAULT 0,
    `wifi_ssid_name` VARCHAR(100) NULL,
    `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------------------
-- 5. Table: audit_logs (Institutional Security & Action Trail)
-- --------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `audit_logs` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `user_id` INT NULL,
    `action` VARCHAR(60) NOT NULL,
    `target_type` VARCHAR(40) NOT NULL,
    `target_id` VARCHAR(50) NULL,
    `details` TEXT NOT NULL,
    `timestamp` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX `idx_audit_user` (`user_id`),
    INDEX `idx_audit_action` (`action`),
    INDEX `idx_audit_time` (`timestamp`),
    CONSTRAINT `fk_audit_user` FOREIGN KEY (`user_id`) 
        REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------------------
-- 6. Table: leave_requests (Teacher Leave Workflow)
-- --------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `leave_requests` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `teacher_id` INT NOT NULL,
    `leave_type` VARCHAR(50) NOT NULL,
    `start_date` DATE NOT NULL,
    `end_date` DATE NOT NULL,
    `reason` TEXT NOT NULL,
    `status` ENUM('pending', 'approved', 'rejected', 'cancelled') NOT NULL DEFAULT 'pending',
    `admin_remarks` TEXT NULL,
    `reviewed_by` INT NULL,
    `reviewed_at` DATETIME NULL,
    `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX `idx_leave_teacher` (`teacher_id`),
    INDEX `idx_leave_status` (`status`),
    INDEX `idx_leave_dates` (`start_date`, `end_date`),
    INDEX `idx_leave_teacher_dates` (`teacher_id`, `start_date`, `end_date`),
    CONSTRAINT `fk_leave_teacher` FOREIGN KEY (`teacher_id`) 
        REFERENCES `users` (`id`) ON DELETE CASCADE,
    CONSTRAINT `fk_leave_reviewer` FOREIGN KEY (`reviewed_by`) 
        REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------------------
-- 7. Table: face_update_requests (Biometric Re-enrollment Workflow)
-- --------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `face_update_requests` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `teacher_id` INT NOT NULL,
    `reason` TEXT NOT NULL,
    `status` ENUM('pending', 'approved', 'rejected', 'cancelled', 'completed') NOT NULL DEFAULT 'pending',
    `admin_remarks` TEXT NULL,
    `reviewed_by` INT NULL,
    `reviewed_at` DATETIME NULL,
    `completed_at` DATETIME NULL,
    `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    `updated_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    INDEX `idx_face_upd_teacher` (`teacher_id`),
    INDEX `idx_face_upd_status` (`status`),
    CONSTRAINT `fk_face_upd_teacher` FOREIGN KEY (`teacher_id`) 
        REFERENCES `users` (`id`) ON DELETE CASCADE,
    CONSTRAINT `fk_face_upd_reviewer` FOREIGN KEY (`reviewed_by`) 
        REFERENCES `users` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------------------
-- 8. Table: notifications (System & User Alerts)
-- --------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `notifications` (
    `id` INT AUTO_INCREMENT PRIMARY KEY,
    `recipient_user_id` INT NOT NULL,
    `notification_type` VARCHAR(40) NOT NULL,
    `title` VARCHAR(150) NOT NULL,
    `message` TEXT NOT NULL,
    `related_record_id` VARCHAR(50) NULL,
    `is_read` TINYINT(1) NOT NULL DEFAULT 0,
    `created_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    INDEX `idx_notif_recipient` (`recipient_user_id`),
    INDEX `idx_notif_read` (`is_read`),
    INDEX `idx_notif_time` (`created_at`),
    CONSTRAINT `fk_notif_recipient` FOREIGN KEY (`recipient_user_id`) 
        REFERENCES `users` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

